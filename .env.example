# These are only read by the ONE server-side piece of this app —
# netlify/functions/shopify-sync.js. Set them in Netlify → Site
# configuration → Environment variables.
#
# The frontend does NOT use env vars for Supabase connection info — it
# talks to Supabase directly with the publishable key + STAFF_EMAIL
# hardcoded in frontend/supabase-config.js (both are safe to be public;
# STAFF_EMAIL is just an identifier, not a secret). The one thing that
# IS a secret and must stay out of the frontend is the staff account's
# actual password (the in-app passcode), which is typed by staff at
# login time and never stored in code.

# Same Supabase project the frontend uses.
SUPABASE_URL=https://vfefipwxeqefdtspzowk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_rzh5gxGVFjHqZbLsz1isvw_cLE6qEB9

# Shopify → Settings → Apps and sales channels → Develop apps → "Rental App"
# → API credentials → Reveal token. Needs read_orders (+ read_customers for
# the "returning customer" check). This one IS a real secret — set it here,
# never in the frontend or in chat.
SHOPIFY_DOMAIN=ricksproshop.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...

# The shared staff login (Supabase Auth) — same account the in-app
# passcode screen signs in as. RLS now requires an authenticated session
# to write, so the sync function logs in with these before touching the
# database. STAFF_PASSWORD is a real secret — set it here only, never in
# frontend code. See README for how to create this account.
STAFF_EMAIL=staff@ricksproshop.local
STAFF_PASSWORD=

# Optional — defaults to "rental". Matches against each line item's
# title/SKU to identify rental orders vs. regular retail orders in the
# same store. See netlify/functions/_lib/shopify-mapping.js.
SHOPIFY_RENTAL_KEYWORD=rental

# Optional — only needed if you set up the real-time webhook (see README
# "Real-time sync" section) in addition to the manual sync button.
# Shopify → Settings → Notifications → Webhooks → shows this after you
# create the webhook. Without this set, the webhook function refuses to
# process anything (fails closed) rather than accepting unverified
# writes to a publicly guessable URL.
SHOPIFY_WEBHOOK_SECRET=
